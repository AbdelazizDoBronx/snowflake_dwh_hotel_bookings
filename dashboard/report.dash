              "point": false
            },
            "encoding": {
              "x": {
                "scale": {
                  "type": "utc"
                },
                "field": "MNTH",
                "type": "temporal",
                "title": "Months",
                "sort": "ascending"
              },
              "y": {
                "field": "TOTAL_AMOUNT",
                "type": "quantitative",
                "title": "AMOUNT",
                "aggregate": "sum",
                "axis": {
                  "labelExpr": "abs(datum.value) >= 1000 ? format(datum.value, '.3~s') : format(datum.value, '')"
