  "datasources": {
    "ds-chart-a8f63eec257d": {
      "type": "sql",
      "columns": [
        {
          "name": "MNTH",
          "type": "DATE"
        },
        {
          "name": "TOTAL_AMOUNT",
          "type": "NUMBER"
        },
        {
          "name": "BOOKINGS",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT \n    DATE_TRUNC('month', check_in_date) AS mnth,\n    ROUND(SUM(total_amount), 2) AS total_amount,\n    COUNT(booking_id) AS bookings\nFROM DWH_HOTEL_BOOKINGS.gold.fct_bookings\nGROUP BY DATE_TRUNC('month', check_in_date)\nORDER BY mnth\n;",
      "filter_bindings": []
    },
    "ds-chart-3e048403ba4c": {
      "type": "sql",
      "columns": [
        {
          "name": "PROPERTY_KEY",
          "type": "VARCHAR"
        },
        {
          "name": "PROPERTY_NAME",
          "type": "VARCHAR"
        },
        {
          "name": "TOTAL_AMOUNT",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    fb.property_key,\n    dp.property_name,\n    SUM(fb.total_amount) AS total_amount\nFROM DWH_HOTEL_BOOKINGS.gold.fct_bookings fb\nLEFT JOIN DWH_HOTEL_BOOKINGS.gold.dim_property dp\nON fb.property_key = dp.property_key\nWHERE fb.property_key IS NOT NULL\nGROUP BY fb.property_key, dp.property_name\nORDER BY total_amount DESC\nLIMIT 5\n;\n",
      "filter_bindings": []
    },
    "ds-chart-dbcad187f459": {
      "type": "sql",
      "columns": [
        {
          "name": "TOTAL_BOOKING",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT COUNT(booking_id) AS total_booking \nFROM DWH_HOTEL_BOOKINGS.GOLD.FCT_BOOKINGS;",
      "filter_bindings": []
    },
    "ds-chart-d668cb9d0508": {
      "type": "sql",
      "columns": [
        {
          "name": "TOTAL_REVENUE",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT ROUND(SUM(total_amount), 2) AS total_revenue FROM DWH_HOTEL_BOOKINGS.GOLD.FCT_BOOKINGS;",
      "filter_bindings": []
    },
    "ds-chart-912d6f015953": {
      "type": "sql",
      "columns": [
        {
          "name": "AVG(NUMBER_OF_NIGHTS)",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT AVG(number_of_nights) FROM dwh_hotel_bookings.gold.fct_bookings;",
      "filter_bindings": []
    }
  }
